<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_appbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/colunaConteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabeçalho: máquina, prioridade e status -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Manutec.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textoMaquina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/azul_aco"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoSetor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/cinza_texto" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/etiquetaPrioridade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_etiqueta"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="3dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/branco"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/etiquetaStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_etiqueta"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="3dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/branco" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/rotulo_problema"
                    android:textAppearance="@style/TextAppearance.Manutec.Rotulo" />

                <TextView
                    android:id="@+id/textoDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/grafite" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/rotulo_linha_do_tempo"
                    android:textAppearance="@style/TextAppearance.Manutec.Rotulo" />

                <TextView
                    android:id="@+id/textoLinhaDoTempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/grafite" />

                <!-- C5: solução registrada (chamado encerrado) -->
                <LinearLayout
                    android:id="@+id/painelSolucao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/rotulo_solucao"
                        android:textAppearance="@style/TextAppearance.Manutec.Rotulo" />

                    <TextView
                        android:id="@+id/textoSolucao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/grafite" />
                </LinearLayout>

                <!-- C5: encerrar (só para o técnico que assumiu) -->
                <LinearLayout
                    android:id="@+id/painelEncerrar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/rotulo_encerrar"
                        android:textAppearance="@style/TextAppearance.Manutec.Rotulo" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campoSolucao"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/campo_solucao"
                        app:counterEnabled="true"
                        app:counterMaxLength="500"
                        app:helperText="@string/campo_solucao_ajuda">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSolucao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botaoEncerrar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/status_encerrado"
                        android:text="@string/acao_encerrar"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- C4: assumir o chamado -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoAssumir"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/laranja"
                    android:text="@string/acao_assumir"
                    android:textColor="@color/grafite"
                    android:visibility="gone"
                    app:icon="@drawable/ic_build"
                    app:iconGravity="textStart"
                    app:iconTint="@color/grafite" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressoAcao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorColor="@color/laranja" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</LinearLayout>
