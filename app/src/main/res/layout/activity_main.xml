<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_aco"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_logo"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/ic_build"
        app:tint="@color/laranja" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="@color/branco"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        app:indicatorColor="@color/laranja" />

    <TextView
        android:id="@+id/textoErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/erro_carregar_perfil"
        android:textColor="@color/branco"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoTentarNovamente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/laranja"
        android:text="@string/acao_tentar_novamente"
        android:textColor="@color/grafite"
        android:visibility="gone"
        app:icon="@drawable/ic_refresh"
        app:iconTint="@color/grafite" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoSair"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/acao_sair"
        android:textColor="@color/branco"
        android:visibility="gone" />

</LinearLayout>
